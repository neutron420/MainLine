# Staging environment
# Copy to terraform.tfvars and fill in real values before applying.
# Never commit terraform.tfvars — it contains secrets.

name       = "schemahub-staging"
environment = "staging"
region     = "us-east-1"

vpc_cidr          = "10.1.0.0/16"
nat_gateway_count = 1

# --- Database (RDS) ---
db_name     = "schemahub"
db_username = "schemahub"
# db_password = ""            # required, no default
rds_engine_version = "16.4"
rds_instance_class = "db.t4g.small"
rds_multi_az       = false

# --- Redis (ElastiCache) ---
redis_engine_version              = "7.1"
redis_node_type                   = "cache.t3.micro"
redis_num_cache_clusters          = 1
redis_transit_encryption_enabled  = false
# redis_auth_token = ""          # required when transit encryption is on

# --- Backend (ECS) ---
backend_image = "ghcr.io/schemahub/backend:staging"
frontend_url  = "https://staging.schemahub.dev"
# jwt_private_key = "-----BEGIN RSA PRIVATE KEY----- ..."   # required, no default
# jwt_public_key  = "-----BEGIN PUBLIC KEY----- ..."        # required, no default
# encryption_key  = "..."                                    # required, >= 32 bytes
backend_desired_count = 1
backend_min_capacity  = 1
backend_max_capacity  = 3
