# ── SchemaHub .gitignore ──

# Environment
.env
.env.local
.env.production
.env.*.local

# Dependencies
node_modules/
vendor/

# Build
.next/
dist/
out/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go
backend/vendor/
backend/server
go.work
go.work.sum
backend/tmp/  # air hot-reload binary

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Test
coverage/
coverage
coverage.out
*.test
*.test.exe

# Python (for scripts)
__pycache__/
*.pyc

# Terraform / Infra
infra/terraform/.terraform/
infra/terraform/terraform.tfstate*
infra/terraform/*.tfplan

# Misc
*.pem
*.key
tmp/
