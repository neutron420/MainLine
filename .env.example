DATABASE_URL="postgres://user:password@host:5432/database?sslmode=require"
REDIS_URL="redis://default:token@host:6379"
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# 32+ byte secret used to encrypt stored database credentials (required)
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL=""
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_CALLBACK_URL=""
PORT=50051
METRICS_PORT=9091
LOG_LEVEL=info
LOG_FORMAT=json
DB_POOL_MIN=2
DB_POOL_MAX=20
RATE_LIMIT_PER_MINUTE=100
STREAM_BUFFER_SIZE=100
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@schemahub.dev"
SMTP_FROM_NAME="SchemaHub"
FRONTEND_URL="http://localhost:3000"
# Optional: runs the Postgres integration suite (internal/integration)
TEST_DATABASE_URL=""
